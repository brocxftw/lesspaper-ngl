# lesspaper-ngl environment example
# Canonical prefix: LESSPAPER_NGL_
# Legacy FOLIUM_* keys are still accepted by the app and Compose during upgrades.
# Postgres role/database names remain "folium" by design.
#
# lesspaper-ngl configuration — copy to .env and edit before first run.
#   cp .env.example .env
#
# Passwords in DATABASE URLs must not contain @ : / # ? (use hex from openssl).
# Compose constructs database URLs from POSTGRES_* — do not point them at localhost
# when using the Docker stack (hostname is "db").

# ---------------------------------------------------------------------------
# Required — set these before docker compose up
# ---------------------------------------------------------------------------

# Image tag (GitHub Release assets pin this to the matching version).
LESSPAPER_NGL_VERSION=latest

# Session/token material and Fernet key for stored provider API keys.
#   openssl rand -hex 32
LESSPAPER_NGL_SECRET_KEY=
LESSPAPER_NGL_ENCRYPTION_KEY=

# PostgreSQL (Docker service "db"). Compose fails if POSTGRES_PASSWORD is empty.
POSTGRES_USER=folium
POSTGRES_PASSWORD=
POSTGRES_DB=folium

# Bootstrap admin — used ONLY on first start when the users table is empty.
# Changing these later does NOT update existing accounts.
# After first boot, change passwords in the UI or:
#   docker compose exec api folium reset-admin-password
LESSPAPER_NGL_ADMIN_USERNAME=admin
LESSPAPER_NGL_ADMIN_PASSWORD=

# Browser origin for CSRF / CORS (your public URL in production).
FRONTEND_ORIGIN=http://localhost:8080

# Open self-service registration. Prefer false; add users via admin invites.
ALLOW_REGISTRATION=false

# ---------------------------------------------------------------------------
# Storage (host paths bind-mounted into the containers as UID 1000)
# ---------------------------------------------------------------------------

# mkdir -p data/documents data/consume data/export data/backups data/paddleocr
# sudo chown -R 1000:1000 data/documents data/consume data/export data/backups data/paddleocr
LESSPAPER_NGL_DOCUMENTS_HOST=./data/documents
LESSPAPER_NGL_CONSUME_HOST=./data/consume
LESSPAPER_NGL_EXPORT_HOST=./data/export
LESSPAPER_NGL_BACKUPS_HOST=./data/backups
LESSPAPER_NGL_PADDLE_CACHE_HOST=./data/paddleocr
# Optional UI label for Settings > System (not inferred from the mount).
# LESSPAPER_NGL_DOCUMENTS_HOST_SOURCE=./data/documents

# In-container paths (must match compose volume targets)
DOCUMENTS_PATH=/documents
CONSUME_PATH=/consume
EXPORT_PATH=/export
BACKUPS_PATH=/backups

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

LESSPAPER_NGL_ENV=production
LESSPAPER_NGL_LOG_LEVEL=INFO
LESSPAPER_NGL_HOST=0.0.0.0
LESSPAPER_NGL_PORT=8000

# Password reset links (after admin approval) expire after this many hours
PASSWORD_RESET_TOKEN_TTL_HOURS=1
MAX_AVATAR_SIZE_MB=2
# DEFAULT_STORAGE_QUOTA_BYTES=
# DEFAULT_AI_MONTHLY_REQUEST_QUOTA=
# Optional: username that owns files dropped into the consume folder
# (default: earliest active admin)
# CONSUME_OWNER_USERNAME=

# Upload limits
MAX_UPLOAD_SIZE_MB=100
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# OCR (PaddleOCR PP-OCRv6 small, CPU). lesspaper-ngl/legacy codes: eng, chi_sim, rus, ara, …
OCR_LANGUAGE=eng
OCR_ENABLED=true
# PDF render DPI for OCR (150 default; raise toward 200 for fine print).
# OCR_DPI=150
# Production runs OCR in a short-lived subprocess so model RAM is reclaimed.
# OCR_IN_PROCESS=false
# OCR_SUBPROCESS_TIMEOUT_SECONDS=3600

# Jobs / trash (default 1 avoids stacking OCR with other heavy jobs)
JOB_CONCURRENCY=1
CONSUME_POLL_INTERVAL_SECONDS=5
JOB_POLL_INTERVAL_SECONDS=2
# JOB_STALE_RUNNING_SECONDS=600
# JOB_LOCK_HEARTBEAT_SECONDS=60
TRASH_RETENTION_DAYS=30
TRASH_PURGE_INTERVAL_SECONDS=3600
APPLICATION_LOG_RETENTION_DAYS=30

# AI defaults (optional — lesspaper-ngl works without an AI provider)
AI_PRIVACY_MODE=local_only
AI_PROFILE=lightweight
AI_ALLOW_REMOTE_EMBEDDINGS=false
AI_ALLOW_REMOTE_QA=false
AI_ALLOW_REMOTE_VISION=false
AI_WARN_BEFORE_REMOTE=true

# Session
SESSION_COOKIE_NAME=folium_session
SESSION_TTL_HOURS=168
CSRF_COOKIE_NAME=folium_csrf

# Optional authoritative About/build metadata. Images set these at build time.
# LESSPAPER_NGL_BUILD_REVISION=
# LESSPAPER_NGL_BUILD_DATE=
# LESSPAPER_NGL_REPOSITORY_URL=https://github.com/brocxftw/lesspaper-ngl
# LESSPAPER_NGL_ISSUES_URL=https://github.com/brocxftw/lesspaper-ngl/issues
# LESSPAPER_NGL_DOCS_URL=https://github.com/brocxftw/lesspaper-ngl/blob/main/docs/README.md
# LESSPAPER_NGL_RELEASES_URL=https://github.com/brocxftw/lesspaper-ngl/releases
# LESSPAPER_NGL_LICENSE_URL=https://github.com/brocxftw/lesspaper-ngl/blob/main/LICENSE
