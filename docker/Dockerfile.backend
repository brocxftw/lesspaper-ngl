FROM python:3.13-slim-bookworm

ARG LESSPAPER_NGL_VERSION=0.0.0-dev
ARG LESSPAPER_NGL_BUILD_REVISION=
ARG LESSPAPER_NGL_BUILD_DATE=
ARG LESSPAPER_NGL_SOURCE=https://github.com/brocxftw/lesspaper-ngl

LABEL org.opencontainers.image.title="lesspaper-ngl backend" \
      org.opencontainers.image.description="lesspaper-ngl API, worker, OCR, indexing, and database migrations" \
      org.opencontainers.image.source="${LESSPAPER_NGL_SOURCE}" \
      org.opencontainers.image.url="${LESSPAPER_NGL_SOURCE}" \
      org.opencontainers.image.documentation="${LESSPAPER_NGL_SOURCE}/blob/main/docs/deployment/install.md" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.version="${LESSPAPER_NGL_VERSION}" \
      org.opencontainers.image.revision="${LESSPAPER_NGL_BUILD_REVISION}" \
      org.opencontainers.image.created="${LESSPAPER_NGL_BUILD_DATE}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_SYSTEM_PYTHON=1 \
    PADDLE_PDX_CACHE_HOME=/app/.paddleocr \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True \
    PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=0 \
    FLAGS_use_mkldnn=0 \
    LESSPAPER_NGL_VERSION=${LESSPAPER_NGL_VERSION} \
    LESSPAPER_NGL_BUILD_REVISION=${LESSPAPER_NGL_BUILD_REVISION} \
    LESSPAPER_NGL_BUILD_DATE=${LESSPAPER_NGL_BUILD_DATE} \
    LESSPAPER_NGL_REPOSITORY_URL=${LESSPAPER_NGL_SOURCE} \
    LESSPAPER_NGL_ISSUES_URL=${LESSPAPER_NGL_SOURCE}/issues \
    LESSPAPER_NGL_DOCS_URL=${LESSPAPER_NGL_SOURCE}/blob/main/docs/README.md \
    LESSPAPER_NGL_RELEASES_URL=${LESSPAPER_NGL_SOURCE}/releases \
    LESSPAPER_NGL_LICENSE_URL=${LESSPAPER_NGL_SOURCE}/blob/main/LICENSE

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        gnupg \
        libmagic1 \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libgfortran5 \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-17 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1000 lesspaper && useradd -u 1000 -g lesspaper -m -s /bin/bash lesspaper \
    && mkdir -p /documents /consume /export /backups /app /app/.paddleocr \
    && chown -R lesspaper:lesspaper /documents /consume /export /backups /app

COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /usr/local/bin/uv

WORKDIR /app
COPY backend/pyproject.toml backend/README.md /app/
COPY backend/src /app/src
COPY backend/alembic /app/alembic
COPY backend/alembic.ini /app/alembic.ini

# PaddlePaddle CPU wheels are published on the official index (not always on PyPI).
# --no-cache avoids filling the layer with huge wheel extract temps.
RUN uv pip install --system --no-cache \
        paddlepaddle==3.3.0 \
        -i https://www.paddlepaddle.org.cn/packages/stable/cpu/ \
    && uv pip install --system --no-cache -e ".[ocr]" \
    && chown -R lesspaper:lesspaper /app

COPY docker/backend-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh \
    && chown lesspaper:lesspaper /app/entrypoint.sh

USER lesspaper

EXPOSE 8000

ENTRYPOINT ["/bin/bash", "/app/entrypoint.sh"]
CMD ["lesspaper-ngl-api"]
